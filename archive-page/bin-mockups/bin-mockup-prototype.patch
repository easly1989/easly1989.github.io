diff --git a/room.css b/room.css
index e68234d..fc769b0 100644
--- a/room.css
+++ b/room.css
@@ -2594,3 +2594,83 @@ html:not(.iso) .strip {
     9px 3px 0 -2px #2a2a2a;
   pointer-events: none;
 }
+
+/* ---- PROTOTYPE: wastebasket variants (?bin=a|b|c) ---- */
+:root {
+  --bin-wire: #3a4045;
+  --bin-enamel: #e3d7bd;
+  --bin-chrome: #b9bfc3;
+  --bin-weave: #b88752;
+  --bin-weave-in: #5b3f22;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bin-wire: #23282b;
+    --bin-enamel: #9b8f76;
+    --bin-chrome: #7d8488;
+    --bin-weave: #7d5a35;
+    --bin-weave-in: #3a2814;
+  }
+}
+.iso .bin3, .iso .bin3 span, .iso .bin3 i, .iso .bin-web {
+  position: absolute; display: block; transform-style: preserve-3d; pointer-events: none;
+}
+.iso .bin3 { width: 0; height: 0; }
+.iso .bin-body { left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0 0; }
+.iso .bin3 .bin-wall { left: 0; top: 0; transform-origin: 50% 0; }
+.iso .bin3 .bin-disc { border-radius: 50%; }
+.iso .bin3 .bin-paper { width: 0; height: 0; }
+.iso .bin-hinge { left: 0; top: 0; width: 0; height: 0; }
+.iso .bin-lid { left: 0; top: 0; width: 0; height: 0; transform: rotate3d(1, 0, 0, 7deg); transform-origin: 0 0 0; }
+.iso .bin-knob { left: -14px; width: 28px; height: 12px; border-radius: 6px 6px 2px 2px; background: color-mix(in srgb, var(--bin-chrome) 70%, black); transform-origin: 50% 0; }
+.iso .bin-pedal { left: 0; top: 0; width: 0; height: 0; }
+.iso .bin-web {
+  width: 150px; height: 120px; transform-origin: 0 0;
+  background:
+    radial-gradient(circle at 100% 0, transparent 0 18px, rgba(255,255,255,.35) 18.5px 19.5px, transparent 20px 38px, rgba(255,255,255,.3) 38.5px 39.5px, transparent 40px 60px, rgba(255,255,255,.25) 60.5px 61.5px, transparent 62px 86px, rgba(255,255,255,.2) 86.5px 87.5px, transparent 88px),
+    repeating-conic-gradient(from 180deg at 100% 0, rgba(255,255,255,.3) 0 0.6deg, transparent 0.6deg 15deg);
+  clip-path: polygon(100% 0, 0 0, 100% 100%);
+  -webkit-mask: radial-gradient(circle at 100% 0, #000 70%, transparent 100%);
+}
+/* A: pointed at, it rocks on its foot and the loose sheets in it jostle */
+.iso .bin-a.poked .bin-body { animation: bin-rock 0.9s ease-out both; }
+.iso .bin-a.poked .jostle { animation: bin-jostle 0.7s ease-out both; }
+.iso .bin-a.poked .j2 { animation-delay: 0.08s; }
+@keyframes bin-rock {
+  0% { transform: none; }
+  20% { transform: rotate3d(1, -1, 0, 5deg); }
+  45% { transform: rotate3d(1, -1, 0, -3deg); }
+  70% { transform: rotate3d(1, -1, 0, 1.5deg); }
+  100% { transform: none; }
+}
+@keyframes bin-jostle {
+  0%, 100% { translate: 0 0 0; }
+  30% { translate: 0 0 22px; }
+  60% { translate: 0 0 4px; }
+}
+/* B: pointed at, the pedal goes down and the lid swings up on its hinge, and back */
+.iso .bin-b .bin-lid { transition: transform 0.45s cubic-bezier(0.5, 0, 0.75, 0); }
+.iso .bin-b.poked .bin-lid { transform: rotate3d(1, 0, 0, 72deg); transition: transform 0.55s var(--ease-spring); }
+.iso .bin-b .bin-pedal { transition: transform 0.3s ease-out; }
+.iso .bin-b.poked .bin-pedal { transform: rotateZ(45deg) translateY(48px) translateZ(-5px) rotateX(-8deg); }
+.iso .bin-b .poke { transition: translate 0.5s var(--ease-spring) 0.15s; }
+.iso .bin-b.poked .poke { translate: 0 0 26px; }
+/* C: pointed at, the sheet on top hops out and drops back, the basket gives a little */
+.iso .bin-c.poked .hop { animation: bin-hop 0.9s ease-out both; }
+.iso .bin-c.poked .bin-body { animation: bin-give 0.9s ease-out both; }
+@keyframes bin-hop {
+  0% { translate: 0 0 0; rotate: 0deg; }
+  35% { translate: 6px 6px 70px; rotate: 0 0 1 40deg; }
+  70% { translate: 0 0 0; rotate: 0 0 1 70deg; }
+  82% { translate: 0 0 10px; }
+  100% { translate: 0 0 0; rotate: 0 0 1 80deg; }
+}
+@keyframes bin-give {
+  0%, 60% { transform: none; }
+  72% { transform: scale3d(1.02, 1.02, 0.97); }
+  86% { transform: scale3d(0.995, 0.995, 1.01); }
+  100% { transform: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  :where(html:not(.motion-ok)) .iso .bin3 *, :where(html:not(.motion-ok)) .iso .bin3 { animation: none !important; transition: none !important; }
+}
